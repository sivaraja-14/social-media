# ---------- Branding ----------
BRAND_NAME=Daily Momentum
BRAND_HANDLE=daily.momentum

# ---------- Instagram (only needed to publish) ----------
# Numeric IG account id of a professional (Business/Creator) account
IG_USER_ID=
# Long-lived access token with instagram_content_publish (and pages_read_engagement)
IG_ACCESS_TOKEN=
# Optional: defaults to v26.0
IG_GRAPH_VERSION=v26.0

# Public URL that serves the contents of the output/ folder.
# GitHub raw:    https://raw.githubusercontent.com/YOUR_USER/YOUR_REPO/main/output
# GitHub Pages:  https://YOUR_USER.github.io/YOUR_REPO/output
IMAGE_BASE_URL=
